    "version": "0.2.0",
    "configurations": [

        {
            "name": "Run Reasonir Task",
            "type": "debugpy",
            "request": "launch",
            // "program": "./evaluation/bright/run.py",
            "program": "run.py",
            "cwd": "${workspaceFolder}/evaluation/bright",
            "args": [
                "--task",
                // tasks=("biology" "earth_science" "economics" "psychology" "robotics" "stackoverflow" "sustainable_living" "leetcode" "pony" "aops" "theoremqa_theorems" "theoremqa_questions")
                "theoremqa_theorems",
                // "biology",
                "--model", "reasonir",
                "--output_dir", "output/reasonir_debug",
                "--cache_dir", "cache",
                // "--reasoning",
                // "gpt4",
                "--encode_batch_size", "-1",
                // "--debug"
            ],
            "console": "integratedTerminal",
            // "justMyCode": false
        },
        {
            "name": "Run Reranker",
            "type": "debugpy",
            "request": "launch",
            "program": "reranker.py",
            "cwd": "${workspaceFolder}/evaluation/bright",
            "args": [
                "--task",
                "theoremqa_theorems",
                "--retriever_score_file",
                "./output/reasonir_gpt4_reasoning/theoremqa_theorems_reasonir_long_False/gpt4_score.json",
                "--input_k",
                "100",
                "--k",
                "100",
                "--output_dir",
                "output/reranker/theoremqa_theorems_reasonir_long_False/",
                "--reasoning",
                "gpt4",
                "--batch_size",
                "50",
                "--model_name",
                // "colbert"
                // "random"
                "qwen"
            ],
            "console": "integratedTerminal",
            // "justMyCode": false
        },
        // {
        //     "name": "Query Rewriting",
        //     "type": "debugpy",
        //     "request": "launch",
        //     "program": "test_time_techniques/query_rewriting.py",
        //     "console": "integratedTerminal",
        //     "args": [
        //         "--task",
        //         "theoremqa_theorems",
        //         "--model",
        //         "meta-llama/Llama-3.1-8B-Instruct",
        //         // "gpt-4o",
        //         // "gpt-3.5-turbo",
        //         "--output_dir", "output/rewritten_queries_llama3",
        //         // "--cache_dir", "cache",
        //         // "--api_key",
        //         // "~/.config/openai_api_key"
        //         // "~/.config/openai_api_key_bright"
        //     ]
        // },
        {
            "name": "Documents augmentation",
            "type": "debugpy",
            "request": "launch",
            "program": "database_augmentation_techniques/documents_augmentation.py",
            "console": "integratedTerminal",
            "args": [
                "--task",
                "theoremqa_theorems",
                "--model",
                "meta-llama/Llama-3.1-8B-Instruct",
                // "gpt-4o",
                // "gpt-3.5-turbo",
                "--output_dir",
                "output/documents_augmentation_llama3_debug_v2",
                // "--cache_dir", "cache",
                // "--api_key",
                // "~/.config/openai_api_key"
                // "~/.config/openai_api_key_bright"
                "--doc_id_range",
                "0:3",
                "--doc_type",
                // "queries",
                "documents",
                "--prompt_as_in_query"
                // "--debug"
            ]
        },
        {
            "name": "Compute Doc Embeds",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/compute_doc_embeds.py",
            "console": "integratedTerminal",
            "args": [
                "--task",
                "theoremqa_theorems",
                "--model",
                "Llama-3.1-8B-Instruct",
                "--save_path",
                "./evaluation/bright/theoremqa_theorems/augmented_doc_emb_gsheeted_same_query_debug.pkl",
                // "./evaluation/bright/theoremqa_theorems/augmented_query_emb_gsheeted_same_query_debug.pkl",
                "--doc_ranges",
                "0:5000,5000:10000,10000:15000,15000:20000,20000:25000",
                // "0:3",
                "--prefix",
                // "docs_True",
                // "debug_queries",
                // "debug_documents",
                "documents_prompt_as_in_query",
                "--base_folder",
                "./output/documents_augmentation_llama3"
                // "./output/documents_augmentation_llama3_debug"
            ]
        }
    ]
}
